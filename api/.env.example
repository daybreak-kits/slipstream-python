# 本地开发默认值，复制为 .env 后按需修改
APP_ENV=local
APP_NAME=Slipstream
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# 可选：32 字节 base64；留空则从 JWT_SECRET 派生
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3680,http://127.0.0.1:3680
DEFAULT_TIMEZONE=Asia/Shanghai

# 默认 httpx（ADR-065）。需要 LiteLLM SDK 归一化的部署再改成 litellm。
UPSTREAM_TRANSPORT=httpx

# 超时（秒）。流式无总闸（ADR-075）：REQUEST_TIMEOUT_S 只约束非流式上游调用
# 并作重试预算参照；流式由连接 / 首字节 / 读空闲三道看门狗约束，生存期归客户端。
REQUEST_TIMEOUT_S=120
UPSTREAM_CONNECT_TIMEOUT_S=10
UPSTREAM_FIRST_BYTE_TIMEOUT_S=30
UPSTREAM_READ_TIMEOUT_S=120

# 进程级上游连接池
UPSTREAM_MAX_CONNECTIONS=200
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=50
UPSTREAM_KEEPALIVE_EXPIRY_S=30

# 数据库连接池（SQLite 会自动忽略池大小，只保留 WAL/busy_timeout）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=1800

# 单请求全局重试预算，防止“轮数 × 候选数”放大；须 ≤ REQUEST_TIMEOUT_S，否则启动失败
GLOBAL_RETRY_MAX_ATTEMPTS=12
GLOBAL_RETRY_BUDGET_S=120
MAX_ATTEMPTS=3

# SIGTERM 排空：只对 production/staging 且主线程生效
SHUTDOWN_GRACE_S=60

# 探测
PROBE_TIMEOUT_S=20
PROBE_MAX_TOKENS=16
# 批量 probe-all 结果缓存（毫秒；0=关闭，force=true 始终绕过）
PROBE_RESULT_TTL_MS=30000

# 熔断：连续失败/限流冷却/故障升级
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_S=30
BREAKER_RATE_LIMIT_COOLDOWN_S=5
BREAKER_FAULT_THRESHOLD=3
BREAKER_FAULT_COOLDOWN_S=300
BREAKER_ESCALATE=true

# 入站请求体上限（字节）
MAX_BODY_BYTES=2000000

# /v1/models 目录缓存（毫秒；0=关闭）
CATALOG_DIRECTORY_TTL_MS=2000

# 请求管线：classic（主干 SQL 路径）或 memory（零 SQL 热路径）
# memory 的实测收益（C=32 流式，3 轮交错）：网关 CPU/请求 -21.7%、RPS +14.5%、p99 -26.6%；
# 并修掉 classic 流式在客户端读完末帧即断连时 0.042% 丢日志行的问题（PERFORMANCE_REPORT.md 第五节）。
USAGE_PIPELINE=memory
# memory 管线轮询目录版本号的间隔（毫秒），即「管理面改动 ≤N ms 对网关可见」；多 worker/多机时调小
CATALOG_POLL_INTERVAL_MS=2000
# 账本写模式：off（单写者）或 split（append-only WAL）
LEDGER_SPLIT=off
# LiteLLM 自带的每请求花费计算（cost-map 查表 + 零花费诊断）：off = stub 掉。
# 计费仍按 DB 单价（billing.compute_cost），没有任何消费者读 litellm 的 response_cost。
# 实测：非流式 -4 ms/请求、流式 -20 ms/请求。将来启用 LiteLLM 预算/花费回调时必须改 on。
LITELLM_COST_CALC=off

# models.dev 每日快照（ADR-073）：开关、地址、落盘目录、超时、人工别名表
# MODELS_DEV_ENABLED=true
# MODELS_DEV_URL=https://models.dev/api.json
# MODELS_DEV_DIR=data/models-dev
# MODELS_DEV_TIMEOUT_S=60
# MODELS_DEV_ALIAS_FILE=
